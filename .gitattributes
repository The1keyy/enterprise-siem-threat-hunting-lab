# Normalize line endings so files written on macOS work on the Windows lab.
* text=auto eol=lf

# Windows scripts: CRLF so they behave predictably on Windows PowerShell 5.1 and cmd.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Linux scripts must stay LF or they break on Ubuntu.
*.sh   text eol=lf

# Pinned upstream Sysmon XML. A few lines are CRLF. Leave the bytes alone so the
# SHA256 matches the sysmon-modular release asset.
configs/sysmon/upstream/sysmonconfig-15.21.xml -text -eol

# Binary files
*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary
*.evtx binary
