# Local wazuh-logtest API user. Copy to .env (gitignored) and change the password.
# VERIFY (4.14.9): the image ships default API users named wazuh and wazuh-wui.
# The stock password for those users is commonly "wazuh". Do not keep that password.
# API_USERNAME / API_PASSWORD are read by the image entrypoint (2-manager).
# A new username is created with the administrator role because that is what
# the image's create_user.py assigns. This container is bound to 127.0.0.1 only.
WAZUH_LOGTEST_API_USER=sentinelforge-logtest
WAZUH_LOGTEST_API_PASSWORD=change-me
