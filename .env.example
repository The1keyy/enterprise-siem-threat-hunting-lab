# SentinelForge environment template.
# Copy to .env and fill in real values. .env is gitignored. Never commit real secrets.

# --- Mode ---
# demo = serve labeled fixture data (UI shows a DEMO DATA banner)
# live = connect to the real Wazuh lab
DATA_MODE=demo

# --- Backend ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./backend/data/sentinelforge.db

# Console login (single lab admin). Store a password HASH, not the password.
CONSOLE_ADMIN_USER=analyst
CONSOLE_ADMIN_PASSWORD_HASH=<BCRYPT_HASH>
SESSION_SECRET=<RANDOM_64_CHARS>

# --- Wazuh manager API (read-only user, created in the lab) ---
WAZUH_API_URL=https://<WAZUH_MANAGER_IP>:55000
WAZUH_API_USER=<WAZUH_READONLY_API_USER>
WAZUH_API_PASSWORD=<WAZUH_READONLY_API_PASSWORD>

# --- Wazuh indexer (read-only user, created in the lab) ---
WAZUH_INDEXER_URL=https://<WAZUH_MANAGER_IP>:9200
WAZUH_INDEXER_USER=<WAZUH_READONLY_INDEXER_USER>
WAZUH_INDEXER_PASSWORD=<WAZUH_READONLY_INDEXER_PASSWORD>

# --- TLS ---
# Path to the lab's root CA so certificates verify properly.
WAZUH_CA_BUNDLE=./configs/wazuh/secrets/root-ca.pem
# LAB ONLY escape hatch. Logged loudly when true. Keep false.
WAZUH_TLS_INSECURE=false

# --- Frontend (Vite reads VITE_* vars) ---
VITE_DATA_MODE=demo
VITE_API_URL=http://127.0.0.1:8000
